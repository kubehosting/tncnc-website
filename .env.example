# Copy this file to .env on the server (or set the same keys in SiteGround
# Site Tools → Node.js → Environment). Do not commit .env.

DATABASE_URL="file:../data/prod.db"
# Set these on the server. Leave them empty in this example.
ADMIN_API_KEY=""
ADMIN_OWNER_EMAIL=""
ADMIN_OWNER_PASSWORD=""

# Optional: send invoice PDFs by email
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="secret"
# SMTP_FROM="TNCNC <info@tncnc.in>"
