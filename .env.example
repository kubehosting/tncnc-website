# SQLite file used by Prisma locally. Switch to PostgreSQL for production.
DATABASE_URL="file:./dev.db"

# Admin dashboard password and API key. Send as:
#   Authorization: Bearer <key>
# or x-admin-api-key: <key>
# The /admin login form uses this same value as the password.
ADMIN_API_KEY="change-me-to-a-long-random-secret"

# Optional: send invoice PDFs by email
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="apikey"
# SMTP_PASS="secret"
# SMTP_FROM="TNCNC <info@tncnc.in>"
